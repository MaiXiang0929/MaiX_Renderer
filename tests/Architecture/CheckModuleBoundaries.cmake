file(GLOB_RECURSE ENGINE_SOURCES "${PROJECT_ROOT}/Engine/*.h" "${PROJECT_ROOT}/Engine/*.cpp")
foreach(source IN LISTS ENGINE_SOURCES)
    file(READ "${source}" content)
    if(content MATCHES "#[ \t]*include[ \t]*[<\"](Editor/|imgui|ImGuizmo|backends/imgui)")
        message(FATAL_ERROR "Engine depends on editor implementation: ${source}")
    endif()
endforeach()
file(GLOB_RECURSE ASSET_SOURCES "${PROJECT_ROOT}/Engine/Asset/*.h" "${PROJECT_ROOT}/Engine/Asset/*.cpp")
foreach(source IN LISTS ASSET_SOURCES)
    file(READ "${source}" content)
    if(content MATCHES "#[ \t]*include[ \t]*[<\"](Engine/Rendering/|glad/|GLFW/)")
        message(FATAL_ERROR "CPU asset import depends on rendering/backend: ${source}")
    endif()
endforeach()
file(GLOB RHI_HEADERS "${PROJECT_ROOT}/Engine/Rendering/RHI/*.h")
foreach(source IN LISTS RHI_HEADERS)
    file(READ "${source}" content)
    if(content MATCHES "#[ \t]*include[ \t]*[<\"](glad/|GLFW/|.*OpenGL/)")
        message(FATAL_ERROR "RHI public interface leaks the backend: ${source}")
    endif()
endforeach()
